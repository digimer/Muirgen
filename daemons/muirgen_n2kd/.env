# This is the connection string to the database server. As it contains your DB
# password in plan text, ensure this file is set to the same owner as the
# daemon and the mode is 0600.
DATABASE_URL=postgres://<db_user>:<db_password>@<ip_or_host>:5432/<db_name>

# This is the network device used to connect to the N2K bus. Note that if this
# is NOT 'can0', you will need to edit or clone the can0-n2k.service systemd
# service and ensure it's enabled on boot.
N2K_DEV=can0

# This is the vessel_uuid of the host vessel this ingestion server is living 
# on.
VESSEL_UUID=<vessels -> vessel_uuid>

# This is a unique ID string that must be unique from any other systemc that 
# set / clear alarms in the Muirgen DB. 
DEV_ID=<unique_name>

# This is the unofficial NMEA2000 "Manufacturer Code". If you're not an NMEA
# licensed vendor, set this to an unused code, like 1999 ir 2046.
MANUFACTURER_CODE=1999

# This is the NMEA serial number string.
SERIAL_NUMBER=000001

# This is the NMEA device class. Generally this should be left as 25 
# (Inter/Intranet Device).
DEVICE_CLASS=25

# This is the function if the device. If unsure, set to 130 (PC Gateway under
# class 25).
DEVICE_FUNCTION=130

# This sets the queue depth for PGNs in case the DB stops responding. A fully
# loaded NMEA2000 network generates 2000 packets per second. At that rate, the
# queue depth translates to 1 GiB of RAM and 1.4 hours of buffer per 10_000_000
# cached records.
PGN_CACHE=20,000,000
